# Docker app ports
APP_PORT=8080
PHPMYADMIN_PORT=8081
DB_PORT_FORWARD=3307

# MySQL container credentials
MYSQL_DATABASE=montera_app
MYSQL_USER=montera
MYSQL_PASSWORD=montera
MYSQL_ROOT_PASSWORD=root

# Application database configuration
DB_HOSTNAME=db
DB_USERNAME=montera
DB_PASSWORD=montera
DB_DATABASE=montera_app
DB_DRIVER=mysqli

# Application environment
CI_ENV=development
BASE_URL=http://localhost:8080/

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI_PROD=
GOOGLE_REDIRECT_URI_LOCAL=http://localhost:8080/googlemeet/oauth2callback

# SMTP Email Configuration
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT_SSL=465
SMTP_PORT_TLS=587

# Telegram Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML

# TikTok Shop API Configuration
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=

# Lazada API Configuration
LAZADA_APP_KEY=
LAZADA_APP_SECRET=

# Shopee API Configuration
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Meta/Facebook API Configuration
META_APP_ID=
META_APP_SECRET=

# TikTok Business Center API Configuration
TIKTOK_BC_APP_ID=
TIKTOK_BC_APP_SECRET=
TIKTOK_BC_ACCESS_TOKEN=

# RapidAPI Configuration
RAPIDAPI_HOST=tiktok-scraper-api4.p.rapidapi.com
